# Store this as ~/.config/twi/recorder.env with mode 0600.
# Tokens belong in the private named credential store, never in service argv.
TWI_RECORD_CHANNEL=example
TWI_RECORD_TRANSPORT=irc
# If automatic refresh needs an application secret, put it in the private real
# env file. Do not uncomment a placeholder or commit a real value here.
# TWI_TWITCH_CLIENT_SECRET=replace-only-in-private-local-file
